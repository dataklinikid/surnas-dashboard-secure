DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-random-secret-with-at-least-50-characters
DJANGO_ALLOWED_HOSTS=dashboard.example.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.id
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Database internal Django pada VPS dashboard (PostgreSQL).
DJANGO_DB_NAME=surnas_dashboard
DJANGO_DB_USER=surnas_dashboard_app
DJANGO_DB_PASSWORD=replace-on-server-only
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=10
DJANGO_DB_SSLMODE=prefer

# Gunicorn dijalankan oleh systemd. Nilai awal konservatif untuk VPS kecil.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Database reporting survei pada VPS CSWeb; akun wajib SELECT-only.
SURNAS_DB_NAME=dbcs76_surnasfeb26_report
SURNAS_DB_USER=surnasfeb26_dashboard_ro
SURNAS_DB_PASSWORD=replace-on-server-only
SURNAS_DB_HOST=database-private-address
SURNAS_DB_PORT=3306
SURNAS_DB_CONNECT_TIMEOUT=10
SURNAS_DB_SSL_CA=
SURNAS_TARGET_N=1260
SURNAS_VALID_COLUMN=
SURNAS_VALID_VALUE=
SURNAS_CACHE_SECONDS=60
